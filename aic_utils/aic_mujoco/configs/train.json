{
  "policy": {
    "type": "act",
    "camera_names": ["center", "left", "right"],
    "state_fields": ["qpos", "qvel"],
    "action_field": "action_delta_q",
    "chunk_size": 16,
    "n_action_steps": 1,
    "vision_backbone": "resnet18",
    "pretrained_backbone_weights": "ResNet18_Weights.IMAGENET1K_V1",
    "replace_final_stride_with_dilation": false,
    "image_mean": [0.485, 0.456, 0.406],
    "image_std": [0.229, 0.224, 0.225],
    "pre_norm": false,
    "dim_model": 256,
    "n_heads": 8,
    "dim_feedforward": 1024,
    "feedforward_activation": "relu",
    "n_encoder_layers": 4,
    "n_decoder_layers": 1,
    "use_vae": true,
    "latent_dim": 32,
    "n_vae_encoder_layers": 2,
    "dropout": 0.1,
    "kl_weight": 10.0
  },
  "training": {
    "device": "cuda:0",
    "seed": 7,
    "batch_size": 128,
    "num_workers": 6,
    "prefetch_factor": 2,
    "steps": 10000,
    "learning_rate": 0.0001,
    "backbone_learning_rate": 0.00001,
    "weight_decay": 0.0001,
    "gradient_clip_norm": 10.0,
    "use_amp": true,
    "amp_dtype": "bfloat16",
    "normalization_minimum_std": 0.000001,
    "minimum_train_episodes": 100,
    "minimum_validation_episodes": 20,
    "log_every_steps": 100,
    "validate_every_steps": 500,
    "validation_batches": 50,
    "checkpoint_every_steps": 1000,
    "output_directory": "../runs/far_approach_act"
  },
  "wandb": {
    "project": "aic-far-approach",
    "run_name": "act-three-camera",
    "mode": "online",
    "watch": "gradients",
    "watch_log_frequency": 100
  }
}
